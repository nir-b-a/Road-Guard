<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_gradient"
    android:padding="24dp">

    <!-- Greeting -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome back 👋"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ready to capture your next drive?"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="32dp" />

    <!-- Primary action -->
    <Button
        android:id="@+id/btnStartDrive"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Start Drive"
        android:textSize="18sp"
        app:icon="@drawable/ic_drive"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        android:layout_marginBottom="16dp" />

    <!-- Notifications with unread badge -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnNotifications"
            style="@style/Widget.RoadGuard.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Notifications"
            android:textSize="17sp"
            app:icon="@drawable/ic_bell"
            app:iconGravity="textStart"
            app:iconSize="24dp" />

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Logout -->
    <Button
        android:id="@+id/btnLogout"
        style="@style/Widget.RoadGuard.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Logout"
        app:icon="@drawable/ic_logout"
        app:iconGravity="textStart"
        app:iconSize="20dp" />

</LinearLayout>
