<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- REC indicator pill -->
    <TextView
        android:id="@+id/tvRecIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REC"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:background="@drawable/bg_rec_pill"
        android:drawableStart="@drawable/rec_dot"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom scrim for control legibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/bg_scrim_bottom"
        app:layout_constraintBottom_toBottomOf="parent" />

    <Button
        android:id="@+id/btnTag"
        style="@style/Widget.RoadGuard.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="Tag"
        android:minWidth="120dp"
        app:icon="@drawable/ic_flag"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="20dp" />

    <Button
        android:id="@+id/btnStop"
        style="@style/Widget.RoadGuard.Button.Destructive"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="Stop"
        android:minWidth="120dp"
        app:icon="@drawable/ic_stop"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
