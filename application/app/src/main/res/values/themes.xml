<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================ Base theme ============================ -->
    <style name="Theme.RoadGuard" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Brand / accent -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/red_record</item>
        <item name="colorOnError">@color/white</item>

        <!-- General widget tinting -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlHighlight">@color/ripple_light</item>

        <!-- Window / system bars -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- App bar -->
        <item name="actionBarStyle">@style/Widget.RoadGuard.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.RoadGuard.ActionBar</item>

        <!-- Default widget styles -->
        <item name="materialButtonStyle">@style/Widget.RoadGuard.Button</item>
    </style>

    <style name="Theme.RoadGuard.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- ============================ App bar ============================ -->
    <style name="Widget.RoadGuard.ActionBar" parent="Widget.MaterialComponents.ActionBar.Surface">
        <item name="background">@color/surface</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/TextAppearance.RoadGuard.ActionBar.Title</item>
    </style>

    <style name="ThemeOverlay.RoadGuard.ActionBar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="colorControlNormal">@color/text_primary</item>
    </style>

    <style name="TextAppearance.RoadGuard.ActionBar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- ============================ Buttons ============================ -->
    <!-- Primary, filled accent button (default for every <Button>) -->
    <style name="Widget.RoadGuard.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">@color/ripple_light</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconTint">@color/white</item>
        <item name="iconPadding">10dp</item>
    </style>

    <!-- Tonal / secondary button (muted blue fill, accent text) -->
    <style name="Widget.RoadGuard.Button.Tonal" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
        <item name="backgroundTint">@color/accent_soft</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">@color/ripple_light</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconTint">@color/accent</item>
        <item name="iconPadding">10dp</item>
    </style>

    <!-- Outlined button -->
    <style name="Widget.RoadGuard.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">@color/ripple_light</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="iconPadding">10dp</item>
    </style>

    <!-- Destructive / stop button -->
    <style name="Widget.RoadGuard.Button.Destructive" parent="Widget.RoadGuard.Button">
        <item name="backgroundTint">@color/red_record</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>

    <!-- Text button (links / toggles) -->
    <style name="Widget.RoadGuard.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>
</resources>
