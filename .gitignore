baseline_violations.json
baseline_other_vehicles_speed.json

# --- Handoff / brief docs (one-off, not final code) --------------------------
CASCADE_STAGE2_HANDOFF.md
GEMINI_BRIEF.md

# --- Cascade dev/analysis tools (sweep/visualize/report, not final pipeline) -
optimize_cascade_parameters.py
tools/cascade_tp_fp_report.py
tools/cascade_visualizer.py

# --- Simulation / baseline helpers (offline-only, not final pipeline) ---------
speed_estimation/simulated_speed.py
violations/baseline_report.py
