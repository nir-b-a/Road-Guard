# =============================================================================
# Road Guard — repo root .gitignore (Python pipeline)
# The Android app, Node backend, and React frontend each have their own
# .gitignore under application/, backend/, and frontend/roadguard-authority/.
# =============================================================================

# --- OS -----------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Python -------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
*.so
*.pyd
build/

# Virtual environments / build dirs — never commit these.
.venv/
venv/
env/
roadguard-dl/
/models/

# --- Model weights ------------------------------------------------------------
# Large + auto-downloadable: ultralytics fetches yolo11x.pt / yolov8*.pt on first
# run; the CLRerNet base weight comes from its model zoo. Ignore all weight blobs
# (*.pt/*.pth/*.onnx/*.engine), then re-include ONLY the two small weights we
# intentionally commit. (Files already tracked stay tracked regardless of this.)
*.pt
*.pth
*.onnx
*.engine
# re-include the two small weights we intentionally commit (custom LPR detector ~6MB;
# validated lane model used by the violation pipeline ~6.5MB):
!israeli_plates.pt
!weights/phase3_v3_yellowprotect.pt
yolo11x.pt

# --- Large local-only data / media -------------------------------------------
# real_vids/ is ~5 GB of dashcam clips + sensor CSVs + generated outputs.
# Never commit it — share via external storage instead.
real_vids/
datasets/
dataset_extraction/
dataset_curation/
tests_videos/
tests_videos/raw_videos/        # downloaded via tests_videos/download_videos.py
test_videos/

# --- Pipeline outputs ---------------------------------------------------------
# Artifacts written next to the input video by main.py / the violation harness.
HOW_TO_RUN.txt
outputs/
# 700MB+ of batch annotated videos + per-clip evidence dumps:
violations_demo/
# local mock-backend inbox (received evidence bundles), if pointed inside the repo:
backend_received_evidence/
output.mp4
*_annotated.mp4
*_vehicles.csv
*_overspeed.csv
*_overspeed.txt
notes.txt
test_1_world.jsonl
test_1_yolo.jsonl

# --- Archived / shelved dev scripts (local only) ------------------------------
tools/_archive/
line_crossing/experiments/
line_crossing/lab_classifiers_v3.py

# --- Cloned, not-on-PyPI framework (install editable; never commit) -----------
UnLanedet/

# --- Secrets ------------------------------------------------------------------
.env
*.env
!.env.example

# --- IDE / tooling ------------------------------------------------------------
.idea/
# Local Claude allow-rules (machine-specific paths) — not shared.
.claude/settings.json

# RoadGuard local pipeline media & diagnostics — keep heavy outputs out of git.
# (note: outputs/ is the cache dir above; output/ is the singular render/diagnostics dir)
output/
output_*/
**/anomaly_frames/

# Media (videos/audio) anywhere — never commit heavy media
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.m4a
*.wav
