# =============================================================================
# Road Guard — repo root .gitignore (Python pipeline)
# The Android app, Node backend, and React frontend each have their own
# .gitignore under application/, backend/, and frontend/roadguard-authority/.
# =============================================================================

# --- OS -----------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Python -------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
*.so
*.pyd
build/

# Virtual environments / build dirs — never commit these.
.venv/
venv/
env/
roadguard-dl/
# /models/ holds training outputs, but the Stage-2 tire weight is re-included below
# (git cannot re-include a file inside a fully excluded directory, hence /models/*).
/models/*

# --- Model weights ------------------------------------------------------------
# Large + auto-downloadable: ultralytics fetches yolo11x.pt / yolov8*.pt on first
# run; the CLRerNet base weight comes from its model zoo. Ignore all weight blobs
# (*.pt/*.pth/*.onnx/*.engine), then re-include ONLY the two small weights we
# intentionally commit. (Files already tracked stay tracked regardless of this.)
*.pt
*.pth
*.onnx
*.engine
# re-include the three small weights we intentionally commit (custom LPR detector ~6MB;
# validated lane model used by the violation pipeline ~6.5MB; Stage-2 tire detector ~5.3MB).
# All three are OURS (fine-tuned in-house) and small enough for git, so a fresh clone can
# run the full pipeline without any private Roboflow key -- see tools/fetch_models.py.
!israeli_plates.pt
!weights/phase3_v3_yellowprotect.pt
!models/tire_yolo11n.pt
yolo11x.pt

# --- Large local-only data / media -------------------------------------------
# real_vids/ is ~5 GB of dashcam clips + sensor CSVs + generated outputs.
# Never commit it — share via external storage instead.
real_vids/
datasets/
dataset_extraction/
dataset_curation/
tests_videos/
tests_videos/raw_videos/        # downloaded via tests_videos/download_videos.py

# --- Pipeline outputs ---------------------------------------------------------
# Artifacts written next to the input video by main.py / the violation harness.
HOW_TO_RUN.txt
outputs/
# 700MB+ of batch annotated videos + per-clip evidence dumps:
violations_demo/
# local mock-backend inbox (received evidence bundles), if pointed inside the repo:
backend_received_evidence/
output.mp4
*_annotated.mp4
*_vehicles.csv
*_overspeed.csv
*_overspeed.txt
notes.txt
test_1_world.jsonl
test_1_yolo.jsonl

# --- Archived / shelved dev scripts (local only) ------------------------------
tools/_archive/
line_crossing/experiments/
line_crossing/lab_classifiers_v3.py
# Removable speed-pipeline diagnostics (not imported by main.py) — keep local.
ego_cancel_diag.py
wide_angle_diag.py

ground_distance/

# --- Cloned, not-on-PyPI framework (install editable; never commit) -----------
UnLanedet/

# --- Tire training pipeline (data + training scripts, not final outcome) ------
tyres_dataset/
tyres_dataset_raw_backup/
runs/
train_tire.py
tools/tire_pipeline/
tools/clean_tire_dataset.py
tools/mine_tire_crops.py
tools/upload_tire_roboflow.py

