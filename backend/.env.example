PORT=5000
MONGO_URI=mongodb://localhost:27017/roadguard
JWT_SECRET=your_super_secret_key_here

# --- Cloudflare R2 (S3-compatible) object storage for the large video + sensor files ---
# Create a bucket + API token at dash.cloudflare.com -> R2. Endpoint is per-account.
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=roadguard
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PRESIGN_EXPIRY=900

# Reject new uploads once the bucket is this full (bytes). Free tier is ~10 GB.
R2_MAX_BYTES=8200547328
# Accepted video size range (bytes): 5 MB .. 4 GB (keep the minimum in sync with the Android app)
VIDEO_MIN_BYTES=5242880
VIDEO_MAX_BYTES=4294967296

# Shared secret the GPU worker sends as x-internal-token on /api/internal/* .
# Leave blank in local dev/tests (routes stay open); set it in production.
INTERNAL_TOKEN=
# Requeue a 'processing' drive if its worker hasn't finished within this many minutes.
# (A worker stopped with `python worker.py --stop-now` / Ctrl+C releases its drive at once instead.)
JOB_STALE_MINUTES=60
# Per-IP request cap per minute (does not apply to /api/internal worker polling).
RATE_LIMIT_MAX=600
JSON_BODY_LIMIT=10mb
