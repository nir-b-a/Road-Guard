# Copy this to .env and fill in your values. .env is gitignored.

# Cloudflare R2 — S3-compatible object storage for videos + evidence bundles
CF_R2_ACCESS_KEY_ID=<your-access-key-id>
CF_R2_SECRET_ACCESS_KEY=<your-secret-access-key>
CF_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CF_R2_BUCKET=roadguard-videos
CF_R2_API_TOKEN=<your-api-token>          # used for CF REST API (account-level ops)

# Hard cap on total bucket usage before uploads are refused (default 3 GB)
CF_R2_MAX_BYTES=3221225472
